# ---------------------------------------------------------------------------
# Never send secrets or runtime data to the Docker daemon.
# ---------------------------------------------------------------------------
.git
.gitignore
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
**/*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.playwright-mcp

# Secrets, databases and runtime state
.env
.env.*
!.env.example
!.env.agent.example
google_keys.json
nvr_data.py
data
temp
*.db
*.db-*
*.sqlite*
*.log
*.pem
*.key

