# ---------------------------------------------------------------------------
# CCTV Control Center v3 — bootstrap environment
#
# Copy this file to `.env` and fill in the values. Only bootstrap secrets belong
# here; Telegram, Google, NVR credentials, folders and thresholds are managed in
# the WebUI and stored in data/cctv.db.
# ---------------------------------------------------------------------------

# Super-admin account. The password is re-synced from here on every startup.
SUPER_ADMIN_USER=superadmin
SUPER_ADMIN_PASSWORD=change-me-before-first-run
SUPER_ADMIN_EMAIL=cctv@example.com

# Signing key for sessions and Fernet encryption of stored secrets.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If omitted, a key is generated once and saved to data/.secret_key.
SECRET_KEY=

# Public address used for links, Telegram MiniApp and email footers.
PUBLIC_URL=https://cctv.footprints.work
PORT=5555
HOST=0.0.0.0
TIMEZONE=Asia/Phnom_Penh

# Runtime user for the app process inside the container. The entrypoint chowns
# ./data to these IDs and drops root privileges before starting. Set them to
# your host user (`id -u`, `id -g`) so ./data stays editable on the host.
PUID=1000
PGID=1000

# Run the Telegram bot and the NVR health scheduler in this process.
RUN_BOT=true
RUN_SCHEDULER=true

# Import a private v2 nvr_data.py once on first boot. Leave false unless you are
# migrating an existing installation and have placed that file in the project
# root. It is git-ignored and excluded from the Docker image.
SEED_LEGACY_NVRS=false

# Optional legacy bootstrap values. The database wins once configured in the UI.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_ID=
# GOOGLE_KEYS_FILE=google_keys.json

# Legacy v2 mailer.py only (root-level cctv_bot.py). The v3 app stores SMTP
# settings in the database under Integrations → SMTP.
# CCTV_SMTP_USER=
# CCTV_SMTP_PASSWORD=
# CCTV_SMTP_CC=
# CCTV_SMTP_APPROVER=
# CCTV_SMTP_HOST=smtp.gmail.com
# CCTV_SMTP_PORT=587

# Set DEBUG=true to expose /api/docs. Keep false in production.
DEBUG=false

# ---------------------------------------------------------------------------
# Remote campus agent (only for the lightweight agent container)
# ---------------------------------------------------------------------------
# RUN_AGENT=true makes this process poll the main host for jobs instead of
# running its own bot/scheduler. AGENT_TOKEN is generated on the main host's
# Campus agents page and shown once.
RUN_AGENT=false
AGENT_MAIN_URL=https://cctv.footprints.work:5555
AGENT_TOKEN=
AGENT_NAME=TTP campus agent
AGENT_CAMPUS=ttp
AGENT_ZONES=ecp,secondary
AGENT_POLL_SECONDS=20
AGENT_WORKERS=2
AGENT_KEEP_FILES=false
AGENT_VERIFY_TLS=true
