# ---------------------------------------------------------------------------
# Remote campus agent environment
#
# Copy this file to `.env.agent` on the campus host and fill in the values.
# Never copy the main server's `.env` here: it contains the main Telegram,
# SMTP and admin secrets.
# ---------------------------------------------------------------------------

# Image to run. Use your published image, or leave the default when building
# from a copied source directory with `--build`.
CCTV_IMAGE=cctv-autonomous-v3:latest

# MAIN host API reachable from this campus. Prefer HTTPS: job payloads contain
# NVR passwords and Google Drive credentials.
# Examples:
#   https://cctv.footprints.work
#   http://172.20.14.4:5555
AGENT_MAIN_URL=https://cctv.example.org

# Token from the main WebUI: Campus agents -> Add agent, or Rotate token.
# It is shown only once. Do not reuse the main app's API key.
AGENT_TOKEN=

# Labels only. Job routing uses the campus/zones stored in the main WebUI,
# so make sure they match the agent record you created there.
AGENT_NAME=TTP campus agent
AGENT_CAMPUS=ttp
AGENT_ZONES=ecp,secondary

AGENT_WORKERS=2
AGENT_POLL_SECONDS=20

# Set false only when AGENT_MAIN_URL uses a self-signed/private HTTPS cert.
AGENT_VERIFY_TLS=true

# Keep downloaded/compressed files after upload. Debug only.
AGENT_KEEP_FILES=false

# Fallback retention for direct downloads. The main WebUI's
# Settings -> Agent keep files (days) value overrides this on each heartbeat.
AGENT_KEEP_FILES_DAYS=7

# Optional direct-download port for a same-host nginx reverse proxy. Keep it
# on loopback; set AGENT_BIND=0.0.0.0 only when nginx runs on another host.
AGENT_BIND=127.0.0.1
AGENT_PORT=5555

# Resumable upload tuning. Smaller chunks survive unreliable WAN links better;
# each chunk is retried without restarting the whole file.
AGENT_UPLOAD_CHUNK_MB=8
AGENT_UPLOAD_RETRIES=4

# Match the owner of ./data on this host (`id -u` / `id -g`).
PUID=1000
PGID=1000
TIMEZONE=Asia/Phnom_Penh
AGENT_CONTAINER_NAME=cctv-agent-ttp
